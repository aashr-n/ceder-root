{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A source in the catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "goodFor", "license", "apps", "bank", "checked", "notes"],
  "properties": {
    "id": { "$ref": "#/definitions/id" },
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "pattern": "^https://" },
    "goodFor": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "licenseUrl": { "type": "string", "pattern": "^https://" },
    "apps": { "$ref": "#/definitions/apps" },
    "bank": { "enum": ["copy", "read", "none"] },
    "attribution": { "type": "string", "minLength": 1 },
    "access": { "type": "string", "minLength": 1 },
    "checked": { "$ref": "#/definitions/checked" },
    "subjects": {
      "description": "The bank's subjects (subjects/<id>/) this source is good for, by id. Leave it out for a general source that serves any subject.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/id" }
    },
    "linking": {
      "description": "Conditions the source's own terms put on a link to it, for an app to obey.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "external": { "description": "A link opens the source's own site, outside the app: never framed, embedded or surrounded by other content.", "const": true },
        "freeOnly": { "description": "A link is never behind a paid feature.", "const": true }
      }
    },
    "parts": {
      "description": "For a source whose licence differs by part: each part that matters, checked on its own.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "license", "apps", "checked", "notes"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "license": { "type": "string", "minLength": 1 },
          "apps": { "$ref": "#/definitions/apps" },
          "attribution": { "type": "string", "minLength": 1 },
          "checked": { "$ref": "#/definitions/checked" },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    },
    "notes": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "apps": { "enum": ["show", "link", "none", "private"] },
    "checked": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "evidence"],
          "properties": {
            "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["url", "quote"],
                "properties": {
                  "url": { "type": "string", "pattern": "^https://" },
                  "quote": { "type": "string", "minLength": 10 },
                  "fromScript": {
                    "description": "The page builds this text with a script it loads, so the quote is looked for in those scripts as well as in the page.",
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}

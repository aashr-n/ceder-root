  "packs": [
    {
      "pack": "propositional-logic",
      "title": "Propositional logic",
      "brief": "Propositions, the logical connectives, truth tables, tautologies and logical equivalence. Stops before quantifiers.",
      "concepts": [
        { "id": "proposition", "name": "Proposition" },
        { "id": "logical-connective", "name": "Logical connective" },
        { "id": "truth-table", "name": "Truth table" },
        { "id": "conditional-statement", "name": "Conditional statement" },
        { "id": "tautology-and-contradiction", "name": "Tautology and contradiction" },
        { "id": "logical-equivalence", "name": "Logical equivalence" }
      ],
      "buildsOn": []
    },
    {
      "pack": "predicate-logic",
      "title": "Predicate logic",

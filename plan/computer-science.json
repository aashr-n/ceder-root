      "buildsOn": ["variable", "expression", "primitive-type"]
    },
    {
      "pack": "functions",
      "title": "Functions",
      "brief": "Defining and calling functions, parameters and arguments, return values, local scope, the call stack, and splitting a program into functions. Stops before recursion.",
      "concepts": [
        { "id": "function-definition", "name": "Function definition and call" },
        { "id": "parameter-argument", "name": "Parameter and argument" },
        { "id": "return-value", "name": "Return value" },
        { "id": "local-scope", "name": "Local scope" },
        { "id": "call-stack", "name": "Call stack" },
        { "id": "decomposition", "name": "Decomposition into functions" }
      ],
      "buildsOn": ["variable", "expression", "conditional-statement"]
    },
    {
      "pack": "testing-and-debugging",
      "title": "Testing and debugging",

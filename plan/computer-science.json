{
  "formatVersion": 1,
  "subject": "computer-science",
  "covers": "Introductory programming and data structures as a two-course first sequence (CS1 and CS2) teaches them, without tying them to one programming language. Stops before graduate topics and before any particular language's libraries.",
  "packs": [
    {
      "pack": "program-basics",
      "title": "Program basics",
      "brief": "Values, variables, assignment, expressions, primitive types, type conversion, and simple console input and output. Stops before any control flow.",
      "concepts": [
        { "id": "variable", "name": "Variable" },
        { "id": "assignment", "name": "Assignment statement" },
        { "id": "primitive-type", "name": "Primitive data type" },
        { "id": "expression", "name": "Expression" },
        { "id": "operator-precedence", "name": "Operator precedence and associativity" },
        { "id": "type-conversion", "name": "Type conversion" },
        { "id": "console-io", "name": "Console input and output" }
      ],
      "buildsOn": []
    },
    {
      "pack": "control-flow",
      "title": "Control flow",
      "brief": "Boolean expressions, conditionals, while and for loops, and nested control structures, including off-by-one errors. Stops before functions.",
      "concepts": [
        { "id": "boolean-expression", "name": "Boolean expression" },
        { "id": "conditional-statement", "name": "Conditional statement" },
        { "id": "while-loop", "name": "While loop" },
        { "id": "for-loop", "name": "For loop" },

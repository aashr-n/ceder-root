      "concepts": [
        { "id": "sample-space", "name": "Sample space" },
        { "id": "complement-rule", "name": "Complement rule" },
        { "id": "addition-rule", "name": "Addition rule" },
        { "id": "conditional-probability", "name": "Conditional probability" },
        { "id": "multiplication-rule", "name": "Multiplication rule" },
        { "id": "independent-events", "name": "Independent events" },
        { "id": "bayes-rule", "name": "Bayes' rule" }
      ],
      "buildsOn": []
    },
    {
      "pack": "distributions",

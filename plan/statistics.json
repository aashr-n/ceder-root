      "concepts": [
        { "id": "frequency-distribution", "name": "Frequency distribution" },
        { "id": "histogram", "name": "Histogram" },
        { "id": "mean", "name": "Mean" },
        { "id": "median", "name": "Median" },
        { "id": "mode", "name": "Mode" },
        { "id": "quantile", "name": "Quartiles and percentiles" },
        { "id": "sample-variance", "name": "Sample variance" },
        { "id": "sample-standard-deviation", "name": "Sample standard deviation" },
        { "id": "outlier", "name": "Outlier" }
      ],
      "buildsOn": []
    },
    {
      "pack": "data-collection",
      "title": "Collecting data",
      "brief": "How data are gathered: observational studies, randomized experiments, and random, stratified and cluster sampling, with the bias and confounding that can spoil them. Stops before probability calculations.",
      "concepts": [
        { "id": "observational-study", "name": "Observational study" },
        { "id": "randomized-experiment", "name": "Randomized experiment" },
        { "id": "control-group", "name": "Control group" },
        { "id": "confounding-variable", "name": "Confounding variable" },
        { "id": "simple-random-sample", "name": "Simple random sample" },
        { "id": "stratified-sampling", "name": "Stratified sampling" },
        { "id": "cluster-sampling", "name": "Cluster sampling" },
        { "id": "sampling-bias", "name": "Sampling bias" }
      ],
      "buildsOn": []
    },
    {
      "pack": "probability",

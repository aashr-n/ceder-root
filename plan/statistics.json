{
  "formatVersion": 1,
  "subject": "statistics",
  "covers": "Introductory statistics, including probability, as a first college course teaches it. Stops before regression beyond simple linear, ANOVA, and Bayesian methods.",
  "packs": [
    {
      "pack": "describing-data",
      "title": "Describing data",

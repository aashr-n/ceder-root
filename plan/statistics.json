      "concepts": [
        { "id": "difference-of-means", "name": "Difference of means" },
        { "id": "independent-samples", "name": "Independent samples" },
        { "id": "two-sample-t-test", "name": "Two-sample t-test" },
        { "id": "paired-data", "name": "Paired data" },
        { "id": "paired-t-test", "name": "Paired t-test" }
      ],
      "buildsOn": ["one-sample-t-test", "confidence-interval", "standard-error", "t-distribution", "test-statistic"]
    },
    {
      "pack": "categorical-data",
      "title": "Proportions and chi-square tests",
      "brief": "Categorical data: sample proportions, their confidence intervals and z-tests, and chi-square goodness-of-fit and independence tests. Stops before correlation.",
      "concepts": [
        { "id": "sample-proportion", "name": "Sample proportion" },
        { "id": "proportion-confidence-interval", "name": "Confidence interval for a proportion" },
        { "id": "one-proportion-z-test", "name": "One-proportion z-test" },
        { "id": "chi-square-distribution", "name": "Chi-square distribution" },
        { "id": "chi-square-goodness-of-fit", "name": "Chi-square goodness-of-fit test" },
        { "id": "chi-square-test-of-independence", "name": "Chi-square test of independence" }
      ],
      "buildsOn": ["binomial-distribution", "normal-distribution", "confidence-interval", "test-statistic", "p-value"]
    },
    {
      "pack": "correlation-and-regression",
      "title": "Correlation and simple linear regression",
      "brief": "Describing the linear relationship between two quantitative variables: scatter plots, the correlation coefficient, the least-squares line, residuals, and R-squared, with a warning that correlation is not causation. Stops before inference about the regression slope.",
      "concepts": [
        { "id": "scatter-plot", "name": "Scatter plot" },
        { "id": "correlation-coefficient", "name": "Correlation coefficient" },
        { "id": "correlation-vs-causation", "name": "Correlation does not imply causation" },
        { "id": "least-squares-line", "name": "Least-squares regression line" },
        { "id": "residual", "name": "Residual" },
        { "id": "coefficient-of-determination", "name": "Coefficient of determination" }
      ],
      "buildsOn": ["z-score", "mean", "sample-standard-deviation", "confounding-variable"]

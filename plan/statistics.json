      "concepts": [
        { "id": "random-variable", "name": "Random variable" },
        { "id": "expected-value", "name": "Expected value" },
        { "id": "random-variable-spread", "name": "Standard deviation of a random variable" },
        { "id": "binomial-distribution", "name": "Binomial distribution" },
        { "id": "normal-distribution", "name": "Normal distribution" },
        { "id": "z-score", "name": "z-score" },
        { "id": "sampling-distribution", "name": "Sampling distribution" },
        { "id": "central-limit-theorem", "name": "Central limit theorem" }
      ],
      "buildsOn": ["sample-space", "conditional-probability", "mean", "sample-standard-deviation"]
    },
    {
      "pack": "estimation",
      "title": "Estimation and confidence intervals",
      "brief": "Using a sample statistic to estimate a population parameter: estimators and their bias, standard error, the t distribution, and confidence intervals with their margin of error. Stops before hypothesis tests.",
      "concepts": [
        { "id": "estimator", "name": "Estimator" },
        { "id": "unbiased-estimator", "name": "Unbiased estimator" },
        { "id": "standard-error", "name": "Standard error" },
        { "id": "t-distribution", "name": "t distribution" },
        { "id": "confidence-interval", "name": "Confidence interval" },
        { "id": "margin-of-error", "name": "Margin of error" }
      ],
      "buildsOn": ["sampling-distribution", "central-limit-theorem", "z-score", "mean", "sample-standard-deviation"]
    },
    {
      "pack": "hypothesis-testing",
      "title": "Hypothesis testing",
      "brief": "The logic of testing one claim about a population mean: null and alternative hypotheses, test statistics, p-values, significance levels, Type I and Type II errors, and power. Stops before comparing two groups.",
      "concepts": [
        { "id": "null-hypothesis", "name": "Null hypothesis" },
        { "id": "alternative-hypothesis", "name": "Alternative hypothesis" },
        { "id": "test-statistic", "name": "Test statistic" },
        { "id": "p-value", "name": "P-value" },
        { "id": "significance-level", "name": "Significance level" },
        { "id": "type-one-and-type-two-errors", "name": "Type I and Type II errors" },
        { "id": "statistical-power", "name": "Statistical power" },
        { "id": "one-sample-t-test", "name": "One-sample t-test" }
      ],
      "buildsOn": ["sampling-distribution", "standard-error", "t-distribution", "confidence-interval"]
    },
    {
      "pack": "two-sample-comparisons",
      "title": "Comparing two groups",

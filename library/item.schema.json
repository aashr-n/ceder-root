{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A pinned piece of an outside source (library/README.md)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "kind",
    "title",
    "url",
    "retrieved",
    "concepts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "part": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "kind": {
      "enum": [
        "text",
        "image",
        "link"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "permalink": {
      "type": "string",
      "pattern": "^https://"
    },
    "retrieved": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]+$"
    },
    "licenseUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "credit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authors",
        "line"
      ],
      "properties": {
        "authors": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "changes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "file": {
      "type": "string",
      "pattern": "^files/[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*\\.(png|jpg)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "alt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "metadata"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "text"
          }
        }
      },
      "then": {
        "required": [
          "license",
          "licenseUrl",
          "changes",
          "text"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "file"
              ]
            },
            {
              "required": [
                "sha256"
              ]
            },
            {
              "required": [
                "width"
              ]
            },
            {
              "required": [
                "height"
              ]
            },
            {
              "required": [
                "alt"
              ]
            },
            {
              "required": [
                "evidence"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "image"
          }
        }
      },
      "then": {
        "required": [
          "license",
          "licenseUrl",
          "changes",
          "file",
          "sha256",
          "width",
          "height",
          "alt"
        ],
        "not": {
          "required": [
            "text"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "link"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "revision"
              ]
            },
            {
              "required": [
                "permalink"
              ]
            },
            {
              "required": [
                "license"
              ]
            },
            {
              "required": [
                "licenseUrl"
              ]
            },
            {
              "required": [
                "credit"
              ]
            },
            {
              "required": [
                "changes"
              ]
            },
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "file"
              ]
            },
            {
              "required": [
                "sha256"
              ]
            },
            {
              "required": [
                "width"
              ]
            },
            {
              "required": [
                "height"
              ]
            },
            {
              "required": [
                "alt"
              ]
            },
            {
              "required": [
                "evidence"
              ]
            }
          ]
        }
      }
    }
  ]
}

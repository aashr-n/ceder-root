{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getceder.com/bank/schema/pack.schema.json",
  "title": "Ceder bank pack",
  "description": "The source format of one pack. See FORMAT.md. tools/validate.mjs checks what a schema can't: that IDs resolve, that nothing cycles, that files exist.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "subject", "title", "summary", "license", "concepts", "items", "artifacts"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 81 },
    "subject": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "license": { "type": "string", "minLength": 1, "maxLength": 40 },
    "concepts": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/concept" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
    "conceptRef": { "type": "string", "pattern": "^([a-z0-9]+(-[a-z0-9]+)*/)?[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 81 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^\\S(.*\\S)?$" },
    "aliases": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/name" } },
    "assetPath": { "type": "string", "pattern": "^assets/[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 120 },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/name" },
        "aliases": { "$ref": "#/$defs/aliases" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
        "requires": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/conceptRef" } },
        "elements": {
          "type": "array", "minItems": 2, "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "name": { "$ref": "#/$defs/name" },
              "aliases": { "$ref": "#/$defs/aliases" }
            }
          }
        },
        "explain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 200, "maxLength": 800 },
            "artifact": { "$ref": "#/$defs/slug" }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["draft", "verified", "rejected"] },
        "method": { "enum": ["blind-solve"] },
        "solvers": { "type": "integer", "minimum": 0 },
        "agreed": { "type": "integer", "minimum": 0 },
        "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string", "maxLength": 500 }
      },
      "if": { "properties": { "status": { "const": "verified" } } },
      "then": { "required": ["status", "method", "solvers", "agreed", "at"], "properties": { "solvers": { "minimum": 1 }, "agreed": { "minimum": 1 } } }
    },
    "item": {
      "type": "object",
      "required": ["id", "concept", "kind", "difficulty", "prompt", "explanation", "verification"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 140 },
        "concept": { "$ref": "#/$defs/slug" },
        "element": { "$ref": "#/$defs/slug" },
        "kind": { "enum": ["choice", "recall", "order", "label"] },
        "difficulty": { "enum": [1, 2, 3] },
        "prompt": { "type": "string", "minLength": 8, "maxLength": 400 },
        "explanation": { "type": "string", "minLength": 8, "maxLength": 500 },
        "artifact": { "$ref": "#/$defs/slug" },
        "sources": {
          "type": "array", "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "url": { "type": "string", "pattern": "^https://", "maxLength": 300 }
            }
          }
        },
        "verification": { "$ref": "#/$defs/verification" }
      },
      "oneOf": [
        {
          "required": ["choices", "answer"],
          "properties": {
            "kind": { "const": "choice" },
            "choices": { "type": "array", "minItems": 2, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
            "answer": { "type": "integer", "minimum": 0, "maximum": 4 }
          }
        },
        {
          "required": ["answer"],
          "properties": {
            "kind": { "const": "recall" },
            "answer": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        },
        {
          "required": ["steps"],
          "properties": {
            "kind": { "const": "order" },
            "steps": { "type": "array", "minItems": 3, "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } }
          }
        },
        {
          "required": ["artifact", "target"],
          "properties": {
            "kind": { "const": "label" },
            "target": { "$ref": "#/$defs/slug" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["id", "kind", "title", "alt"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "kind": { "enum": ["diagram", "model3d", "sequence"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "alt": { "type": "string", "minLength": 10, "maxLength": 500 },
        "credit": { "type": "string", "maxLength": 120 }
      },
      "oneOf": [
        {
          "required": ["file"],
          "properties": {
            "kind": { "const": "diagram" },
            "file": { "allOf": [{ "$ref": "#/$defs/assetPath" }, { "pattern": "\\.svg$" }] },
            "hotspots": {
              "type": "array", "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "x", "y", "r"],
                "properties": {
                  "id": { "$ref": "#/$defs/slug" },
                  "label": { "type": "string", "minLength": 1, "maxLength": 40 },
                  "x": { "type": "number", "minimum": 0, "maximum": 1 },
                  "y": { "type": "number", "minimum": 0, "maximum": 1 },
                  "r": { "type": "number", "minimum": 0.04, "maximum": 0.3 }
                }
              }
            }
          }
        },
        {
          "required": ["files", "poster"],
          "properties": {
            "kind": { "const": "model3d" },
            "files": {
              "type": "object",
              "additionalProperties": false,
              "required": ["usdz"],
              "properties": {
                "usdz": { "allOf": [{ "$ref": "#/$defs/assetPath" }, { "pattern": "\\.usdz$" }] },
                "glb": { "allOf": [{ "$ref": "#/$defs/assetPath" }, { "pattern": "\\.glb$" }] }
              }
            },
            "poster": { "allOf": [{ "$ref": "#/$defs/assetPath" }, { "pattern": "\\.png$" }] }
          }
        },
        {
          "required": ["over", "steps"],
          "properties": {
            "kind": { "const": "sequence" },
            "over": { "$ref": "#/$defs/slug" },
            "steps": {
              "type": "array", "minItems": 3, "maxItems": 7,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "text"],
                "properties": {
                  "title": { "type": "string", "minLength": 1, "maxLength": 40 },
                  "text": { "type": "string", "minLength": 1, "maxLength": 160 },
                  "focus": { "$ref": "#/$defs/slug" }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getceder.com/bank/schema/subject.schema.json",
  "title": "Ceder bank subject",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "name", "domain", "summary"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/slug" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "domain": { "enum": ["natural", "formal", "social", "humanities", "applied"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 }
  }
}
